# Pyre type checker
.pyre/

# SonicMaster checkpoint (~3.3GB) — downloaded on demand per
# specs/006-audio-engine-masterizacao/research.md, never committed (unlike
# the much smaller image/video checkpoints already tracked under models/).
models/sonicmaster.safetensors
models/sonicmaster/

# Ad hoc local audio fixtures generated manually while testing the
# audio-engine (real pytest fixtures are synthesized inline in the test
# files themselves, not committed as standalone files).
/teste_*.wav

# Binários empacotados para o instalador Windows. Gerados por
# `build:backend:win` (PyInstaller) e por `fetch:ffmpeg:win` — 821 MB em ~3.000
# arquivos que se reconstroem a partir do código. Sem estas linhas, um
# `git add -A` os leva para o histórico, e um histórico não desengorda.
interface/resources/backend/
interface/resources/ffmpeg/
# Fixtures de mídia dos testes (specs/007 e 008). Geradas sob demanda por
# `python -m tests.fixtures.make_video_fixtures`, e deliberadamente fora do git:
# alguns segundos de codificação custam menos que 3,6 MB de binário no
# histórico, e a fixture passa a corresponder ao FFmpeg que a pessoa de fato
# tem. Um `git add -A` já as pegou uma vez; esta linha é o que impede a próxima.
api/eterzion_upscale_api/tests/fixtures/*.mp4
api/eterzion_upscale_api/tests/fixtures/*.webm
api/eterzion_upscale_api/tests/fixtures/*.wav
api/eterzion_upscale_api/tests/fixtures/*.gif

# O projeto usa pnpm. Um package-lock.json aqui não é redundância inofensiva:
# quem rodar `npm install` monta uma árvore diferente da que o pnpm-lock.yaml
# descreve, e o pacote sai com dependências que ninguém escolheu.
interface/package-lock.json

# Cache incremental do TypeScript: artefato de build local.
*.tsbuildinfo
