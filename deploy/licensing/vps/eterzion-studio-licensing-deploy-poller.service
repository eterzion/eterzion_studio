[Unit]
Description=Pull and deploy the validated Eterzion Studio licensing release
Documentation=https://github.com/eterzion/eterzion_studio/blob/main/deploy/licensing/README.md
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
SupplementaryGroups=docker
WorkingDirectory=/opt/eterzion-studio-licensing
RuntimeDirectory=eterzion-studio-licensing-deploy
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock --nonblock /run/eterzion-studio-licensing-deploy/deploy.lock /opt/eterzion-studio-licensing/scripts/poll-production-release.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/eterzion-studio-licensing /run/eterzion-studio-licensing-deploy /run/docker.sock

[Install]
WantedBy=multi-user.target
