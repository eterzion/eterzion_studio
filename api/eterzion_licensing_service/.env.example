# Copy this file to .env on the VPS and provide only the integrations in use.
# Never commit real credentials.

ETERZION_LICENSING_STRIPE_WEBHOOK_SECRET=
ETERZION_LICENSING_MERCADOPAGO_WEBHOOK_SECRET=
ETERZION_LICENSING_MERCADOPAGO_ACCESS_TOKEN=

# Downloads do Studio pelo R2 (POST /downloads/token). Precisa ser IDENTICA ao
# segredo STUDIO_SIGNING_KEY do Worker de cdn.eterzion.com (repositorio
# eterzion_assets) e exclusiva do Studio -- nunca a SIGNING_KEY do catalogo.
# Gerar com: openssl rand -hex 32. Vazia = rota desligada (503).
ETERZION_LICENSING_STUDIO_CDN_SIGNING_KEY=
